{
  "mcpServers": {
    "medium-playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.69",
        "--browser",
        "chrome",
        "--user-data-dir",
        "C:\\PATH\\TO\\mcp-browser-profiles\\medium",
        "--timeout-action",
        "10000",
        "--timeout-navigation",
        "90000",
        "--viewport-size",
        "1440x1000"
      ]
    }
  }
}
