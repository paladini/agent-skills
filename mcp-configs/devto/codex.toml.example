# Merge this table into %USERPROFILE%\.codex\config.toml on Windows.
# Replace paths and the placeholder locally. Never commit the resolved secret.

[mcp_servers.devto]
command = "C:\\PATH\\TO\\uv.exe"
args = ["--directory", "C:\\PATH\\TO\\devto-mcp", "run", "server.py"]

[mcp_servers.devto.env]
DEV_TO_API_KEY = "REPLACE_WITH_LOCAL_SECRET"
